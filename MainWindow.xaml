<Window x:Class="WEBPMemeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="WEBP Text Editor"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Browse WEBP" Width="120" Height="32"
                    Margin="0,0,10,0" Click="BrowseButton_Click"/>

            <TextBlock Text="{Binding FileName}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Background="#222">
                <skia:SKElement x:Name="PreviewCanvas"
                                PaintSurface="PreviewCanvas_PaintSurface"/>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Add Text Segment"
                        Grid.Column="0"
                        Width="150"
                        Height="32"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Click="AddSegmentButton_Click"/>


                <Button Content="Decrease Font Size"
                        Grid.Column="1"
                        Width="150"
                        Height="32"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>


                <Button Content="Increase Font Size"
                        Grid.Column="2"
                        Width="150"
                        Height="32"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1"
                          Grid.ColumnSpan="3"
                          ItemsSource="{Binding TextSegments}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
                        <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="110"/>
                        <DataGridTextColumn Header="Stop Time" Binding="{Binding StopTime}" Width="110"/>

                        <DataGridTemplateColumn Header="Remove" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Click="RemoveSegmentButton_Click"
                                            Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Play"
                    Width="80" Height="32"
                    Margin="0,0,10,0"
                    Click="PlayButton_Click"/>

            <Slider Grid.Column="1"
                    Minimum="0"
                    Maximum="{Binding DurationSeconds}"
                    Value="{Binding CurrentTimeSeconds, Mode=TwoWay}"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding CurrentTimeDisplay}"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <Button Grid.Column="3" Content="Save"
                    Width="90" Height="32"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>