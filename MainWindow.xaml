<Window x:Class="WEBPMemeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="WEBP Text Editor"        
        FontFamily="{StaticResource Montserrat-Regular}"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <DockPanel>
                <Button Content="Browse WEBP"/>

                <TextBlock Text="{Binding FileName}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>


        <Border Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <skia:SKElement x:Name="PreviewCanvas"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Add Text Segment"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Left"/>

                    <Button Content="Decrease Font Size"                        
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Left"/>

                    <Button Content="Increase Font Size"
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Left"/>

                    <DataGrid Grid.Row="1"
                          Grid.ColumnSpan="3"
                          ItemsSource="{Binding TextSegments}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Text"/>
                            <DataGridTextColumn Header="Start Frame"/>
                            <DataGridTextColumn Header="Stop Frame"/>

                            <DataGridTemplateColumn Header="Remove" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="Play"/>

            <Slider Grid.Column="1"
                    Minimum="0"
                    Maximum="0"
                    VerticalAlignment="Center"/>

            <Button Grid.Row="0"
                    Grid.Column="3" 
                    Content="Save"/>
        </Grid>
    </Grid>
</Window>