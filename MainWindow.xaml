<Window x:Class="WEBPMemeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="WEBP Text Editor"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Browse WEBP" Click="BrowseButton_Click"/>

                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding FileName}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0"
                      Margin="0"                      
                      Width="{Binding ImageWidth}"
                      Height="{Binding ImageHeight}">
                    <skia:SKElement Margin="0" PaintSurface="SkiaImage_PaintSurface" Name="SkiaControl"/>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>                        
                    </Grid.ColumnDefinitions>

                    <Button Content="Add Text Segment"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Click="AddTextSegment_Click"/>
                    
                    <ComboBox Grid.Row="0" 
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding DataContext.FontSizes, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                        
                    <DataGrid ItemsSource="{Binding TextSegments}"
                              SelectedItem="{Binding SelectedTextSegment, Mode=TwoWay}"
                              RowStyle="{StaticResource TextSegmentRowStyle}"
                              CellStyle="{StaticResource TextSegmentCellStyle}"
                              AutoGenerateColumns="False"
                              Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Text">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Text"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="PropertyChanged" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartFrame}" />
                            <DataGridTextColumn Header="Stop" Binding="{Binding StopFrame}" />

                            <DataGridTemplateColumn Header="Remove">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Click="RemoveTextSegment_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
                    Grid.Column="0"
                    Content="Play"
                    Click="PlayPauseButton_Click" />
            
            <Slider Grid.Column="1" 
                    Minimum="0"
                    Maximum="{Binding MaxFrameIndex}"
                    Value="{Binding CurrentFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsSnapToTickEnabled="True"
                    TickPlacement="BottomRight"
                    TickFrequency="1" />

            <Button Grid.Row="0"
                    Grid.Column="3" 
                    Content="Save"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>